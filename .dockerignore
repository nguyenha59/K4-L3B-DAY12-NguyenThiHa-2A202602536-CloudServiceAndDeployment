# CP2 — những thứ KHÔNG được đưa vào build context / image.
# Không ignore app/, utils/, requirements.txt — image cần chúng.

# Secret
.env
.env.*
!.env.example
*.pem
*.key

# Git & CI
.git
.gitignore
.github

# Python
__pycache__
*.pyc
*.pyo
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Không cần khi chạy
tests
screenshots
*.md
Dockerfile*
docker-compose*.yml
nginx
.vscode
.idea
.DS_Store
